{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "aspen",
  "name": "BabySea Docs",
  "colors": {
    "primary": "#48d1cc",
    "light": "#0c9b97",
    "dark": "#0c9b97"
  },
  "favicon": "/static/favicon.ico",
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "FAQ",
          "icon": "comment-question",
          "color": {
            "light": "#0c9b97",
            "dark": "#0c9b97"
          },
          "href": "https://babysea.ai/faq"
        },
        {
          "anchor": "Pricing plan",
          "icon": "credit-card",
          "color": {
            "light": "#0c9b97",
            "dark": "#0c9b97"
          },
          "href": "https://babysea.ai/pricing-plan"
        },
        {
          "anchor": "Model pricing",
          "icon": "dollar-sign",
          "color": {
            "light": "#0c9b97",
            "dark": "#0c9b97"
          },
          "href": "https://babysea.ai/model-pricing"
        },
        {
          "anchor": "Model schema",
          "icon": "file-code",
          "color": {
            "light": "#0c9b97",
            "dark": "#0c9b97"
          },
          "href": "https://babysea.ai/model-schema"
        }
      ]
    },
    "tabs": [
      {
        "tab": "Documentation",
        "icon": "book-open",
        "groups": [
          {
            "group": "Introduction",
            "icon": "house",
            "pages": ["index"]
          },
          {
            "group": "Get started",
            "icon": "rocket",
            "pages": [
              "quickstart",
              "setup/api",
              "setup/generations",
              "setup/sdk",
              "setup/webhooks",
              "setup/errors",
              "setup/notifications"
            ]
          },
          {
            "group": "Dashboard",
            "icon": "gauge",
            "pages": [
              "dashboard/metrics",
              "dashboard/api-keys",
              "dashboard/webhook",
              "dashboard/logs",
              "dashboard/credits",
              "dashboard/playground",
              "dashboard/models",
              "dashboard/domains",
              "dashboard/settings",
              "dashboard/members",
              "dashboard/billing",
              "dashboard/my-profile",
              "dashboard/activity"
            ]
          },
          {
            "group": "Updates",
            "icon": "megaphone",
            "pages": ["changelog"]
          }
        ]
      }
    ]
  },
